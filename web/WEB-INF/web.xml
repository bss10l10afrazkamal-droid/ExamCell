<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="3.1">

    <display-name>ExamCell</display-name>

    <servlet>
        <servlet-name>ViewTimetable</servlet-name>
        <servlet-class>ViewTimetableServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ViewTimetable</servlet-name>
        <url-pattern>/timetable</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>timetable</welcome-file>
    </welcome-file-list>

</web-app>
